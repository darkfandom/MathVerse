<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Canvas -->
  <Color x:Key="CanvasColor">#0B0B12</Color>

  <!-- Surfaces -->
  <Color x:Key="SurfaceColor">#12121E</Color>
  <Color x:Key="SurfaceElevatedColor">#1A1A2E</Color>

  <!-- Borders -->
  <Color x:Key="BorderColor">#2A2A3E</Color>

  <!-- Text -->
  <Color x:Key="TextPrimaryColor">#E8E8F0</Color>
  <Color x:Key="TextSecondaryColor">#7A7A96</Color>
  <Color x:Key="TextTertiaryColor">#4A4A64</Color>

  <!-- Accents -->
  <Color x:Key="AccentBlueColor">#4A9EFF</Color>
  <Color x:Key="AccentPurpleColor">#8B5CF6</Color>
  <Color x:Key="AccentTealColor">#06D6A0</Color>
  <Color x:Key="AccentOrangeColor">#FF6B35</Color>
  <Color x:Key="AccentRedColor">#FF4444</Color>
  <Color x:Key="AccentGoldColor">#FFD700</Color>

</ResourceDictionary>
