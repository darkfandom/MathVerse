<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Core Backgrounds -->
  <Color x:Key="BackgroundDark">#0B0B12</Color>
  <Color x:Key="BackgroundPanel">#13131E</Color>
  <Color x:Key="BackgroundHeader">#1A1A26</Color>
  <Color x:Key="BackgroundBar">#15151E</Color>
  <Color x:Key="BackgroundInput">#0F0F18</Color>

  <!-- Text -->
  <Color x:Key="TextPrimary">#E0E0E0</Color>
  <Color x:Key="TextSecondary">#888888</Color>
  <Color x:Key="TextMuted">#555555</Color>
  <Color x:Key="TextPlaceholder">#444444</Color>

  <!-- Borders -->
  <Color x:Key="BorderDefault">#222222</Color>
  <Color x:Key="BorderSubtle">#1A1A1A</Color>
  <Color x:Key="BorderSplitter">Transparent</Color>

  <!-- Accent -->
  <Color x:Key="AccentBlue">#4A9EFF</Color>
  <Color x:Key="AccentGreen">#4CAF50</Color>
  <Color x:Key="AccentRed">#F44336</Color>
  <Color x:Key="AccentOrange">#FF9800</Color>

  <!-- Selection -->
  <Color x:Key="SelectionActive">#2D5F8A</Color>
  <Color x:Key="SelectionInactive">#1E3A52</Color>

  <!-- Interactive -->
  <Color x:Key="ButtonHover">#2A2A3E</Color>
  <Color x:Key="ButtonPressed">#3A3A52</Color>
</ResourceDictionary>
