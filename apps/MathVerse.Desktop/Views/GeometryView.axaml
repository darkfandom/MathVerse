<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathVerse.Desktop.Views.GeometryView">

  <Border Background="{DynamicResource SurfaceBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="&#x25B3;" FontSize="48" HorizontalAlignment="Center"
                 Foreground="{DynamicResource AccentOrangeBrush}" Opacity="0.3"/>
      <TextBlock Text="Geometry Studio" FontSize="20" FontWeight="300" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="Explore shapes and constructions" FontSize="13" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
  </Border>

</UserControl>
