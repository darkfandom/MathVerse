<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathVerse.Desktop.Views.VisualizeView">

  <Border Background="{DynamicResource SurfaceBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="&#x25CE;" FontSize="48" HorizontalAlignment="Center"
                 Foreground="{DynamicResource AccentTealBrush}" Opacity="0.3"/>
      <TextBlock Text="Visualization Studio" FontSize="20" FontWeight="300" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="Create stunning 3D visualizations" FontSize="13" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
  </Border>

</UserControl>
