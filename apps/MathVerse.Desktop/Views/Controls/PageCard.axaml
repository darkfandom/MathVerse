<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathVerse.Desktop.Views.Controls.PageCard"
             x:Name="Root">

  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1" CornerRadius="12" Padding="20"
          MinHeight="100" MinWidth="180">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding CardTitle, ElementName=Root}"
                 FontSize="15" FontWeight="600" Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="{Binding CardSubtitle, ElementName=Root}"
                 FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                 TextWrapping="Wrap" MaxLines="2"/>
    </StackPanel>
  </Border>

</UserControl>
