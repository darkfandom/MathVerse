<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathVerse.Desktop.ViewModels"
             x:Class="MathVerse.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Border Background="{DynamicResource CanvasBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="20" Margin="40,32,40,40" MaxWidth="600"
                  HorizontalAlignment="Left">

        <!-- Header -->
        <StackPanel Spacing="4">
          <TextBlock Text="Settings" FontSize="24" FontWeight="300"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="Configure MathVerse" FontSize="13"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Appearance Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="20,16">
          <StackPanel Spacing="16">
            <TextBlock Text="Appearance" FontSize="13" FontWeight="600"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- UI Scale -->
            <StackPanel Spacing="6">
              <TextBlock Text="UI Scale" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <ComboBox ItemsSource="{Binding UiScales}"
                        SelectedIndex="{Binding SelectedThemeIndex}"
                        MinWidth="200" FontSize="12"/>
            </StackPanel>

            <!-- Theme -->
            <StackPanel Spacing="6">
              <TextBlock Text="Theme" FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock Text="Dark" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Performance Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="20,16">
          <StackPanel Spacing="16">
            <TextBlock Text="Performance" FontSize="13" FontWeight="600"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- GPU Acceleration -->
            <CheckBox Content="GPU Acceleration"
                      IsChecked="{Binding GpuAcceleration}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Enable hardware-accelerated rendering for graphs and visualizations."
                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap" Margin="24,0,0,0"/>
          </StackPanel>
        </Border>

        <!-- About Section -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="20,16">
          <StackPanel Spacing="12">
            <TextBlock Text="About" FontSize="13" FontWeight="600"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="MathVerse Desktop v0.6.0" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="A scientific mathematics platform with CAS, graphing, and visualization."
                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Reset Button -->
        <Button Content="Reset to Defaults" Command="{Binding ResetDefaultsCommand}"
                HorizontalAlignment="Left" FontSize="12" Padding="16,6"
                CornerRadius="6" Margin="0,8,0,0"
                Background="{DynamicResource SurfaceElevatedBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"/>

      </StackPanel>
    </ScrollViewer>
  </Border>

</UserControl>
