<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathVerse.Desktop.Views.SettingsView">

  <Border Background="{DynamicResource SurfaceBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="&#x2699;" FontSize="48" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.3"/>
      <TextBlock Text="Settings" FontSize="20" FontWeight="300" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="Configure MathVerse" FontSize="13" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
  </Border>

</UserControl>
