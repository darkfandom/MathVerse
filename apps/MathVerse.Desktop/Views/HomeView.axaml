<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathVerse.Desktop.ViewModels"
             xmlns:controls="using:MathVerse.Desktop.Views.Controls"
             x:Class="MathVerse.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="32" Margin="40,32,40,40">

      <!-- Welcome Section -->
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding WelcomeMessage}" FontSize="28" FontWeight="300"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{Binding StatusSummary}" FontSize="14"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>

      <!-- Module Cards Grid -->
      <StackPanel Spacing="12">
        <TextBlock Text="MODULES" FontSize="11" FontWeight="700"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Opacity="0.8" Margin="0,0,0,4"/>
        <WrapPanel Orientation="Horizontal">
          <WrapPanel.Styles>
            <Style Selector="WrapPanel > Button">
              <Setter Property="Margin" Value="0,0,16,12"/>
            </Style>
          </WrapPanel.Styles>
          <controls:PageCard CardTitle="Evaluate" CardSubtitle="Compute and simplify expressions" Tag="evaluate" Click="OnCardClick"/>
          <controls:PageCard CardTitle="Graph Studio" CardSubtitle="Plot functions in 2D and 3D" Tag="graph" Click="OnCardClick"/>
        </WrapPanel>
      </StackPanel>

      <!-- Quick Start -->
      <StackPanel Spacing="8">
        <TextBlock Text="QUICK START" FontSize="11" FontWeight="700"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Opacity="0.8" Margin="0,0,0,4"/>
        <TextBlock Text="Type an expression like sin(pi/2) + 3^2 and press Enter to evaluate."
                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>
        <TextBlock Text="Go to Graph Studio to plot functions like sin(x), x^2, or cos(x)."
                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
