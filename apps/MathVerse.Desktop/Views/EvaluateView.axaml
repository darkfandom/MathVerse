<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathVerse.Desktop.ViewModels"
             x:Class="MathVerse.Desktop.Views.EvaluateView"
             x:DataType="vm:EvaluateViewModel"
             Background="{DynamicResource CanvasBrush}">

  <Grid ColumnDefinitions="200,*,220" RowDefinitions="*">

    <!-- ═══ LEFT: Variables Panel ═══ -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
            CornerRadius="0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
          <TextBlock Text="Variables" FontSize="11" FontWeight="600"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Watermark="Select var (for d/dx)"
                     Text="{Binding SelectedVariable}" FontSize="11"
                     CornerRadius="4" MinHeight="24" Padding="6,3"
                     Background="{DynamicResource CanvasBrush}"/>
            <TextBlock Grid.Column="1" Text="d/dx" FontSize="10" Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
          </Grid>
        </Border>

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Variables}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:VariableItem}">
                <Border CornerRadius="4" Padding="10,5" Margin="2,1"
                        Background="{DynamicResource CanvasBrush}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                               FontSize="12" FontWeight="500"
                               Foreground="{DynamicResource AccentTealBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ═══ CENTER: Editor + Toolbar + Results ═══ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto"
          Margin="0">

      <!-- Expression Editor -->
      <Border Grid.Row="0" Margin="20,16,20,0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="10">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="14,8"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Expression" FontSize="10" FontWeight="600"
                       Foreground="{DynamicResource TextTertiaryBrush}"
/>
          </Border>
          <TextBox x:Name="ExpressionTextBox"
                   Text="{Binding ExpressionInput}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   FontFamily="Cascadia Code, Consolas, monospace"
                   FontSize="16" MinHeight="60" MaxHeight="120"
                   Padding="14,10"
                   Background="Transparent"
                   BorderThickness="0"
                   KeyDown="ExpressionTextBox_KeyDown"/>
        </DockPanel>
      </Border>

      <!-- Operation Toolbar -->
      <Border Grid.Row="1" Margin="20,10,20,0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="8">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,6"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Operations" FontSize="10" FontWeight="600"
                       Foreground="{DynamicResource TextTertiaryBrush}"
/>
          </Border>

          <WrapPanel Margin="8,6">
            <Button Content="&#x21B5; Evaluate" Command="{Binding EvaluateCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource AccentBlueBrush}"
                    Foreground="#FFFFFF" FontSize="11" FontWeight="500"/>
            <Button Content="&#x2248; Simplify" Command="{Binding SimplifyOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
            <Button Content="&#x2044; Factor" Command="{Binding FactorOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
            <Button Content="&#x2716; Expand" Command="{Binding ExpandOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
            <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                    Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="d/dx" Command="{Binding DifferentiateOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource AccentPurpleBrush}"
                    Foreground="#FFFFFF" FontSize="11" FontWeight="500"/>
            <Button Content="&#x222B; Integral" Command="{Binding IntegrateOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource AccentPurpleBrush}"
                    Foreground="#FFFFFF" FontSize="11" FontWeight="500"/>
            <Button Content="lim" Command="{Binding LimitOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
            <Button Content="&#x03A3; Series" Command="{Binding SeriesOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
            <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}"
                    Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="= Solve" Command="{Binding SolveOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource AccentTealBrush}"
                    Foreground="#FFFFFF" FontSize="11" FontWeight="500"/>
            <Button Content="Stats" Command="{Binding StatisticsOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
            <Button Content="Matrix" Command="{Binding MatrixOperationCommand}"
                    Margin="0,0,4,4" CornerRadius="5" Padding="10,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
          </WrapPanel>
        </DockPanel>
      </Border>

      <!-- Result Panel -->
      <Border Grid.Row="2" Margin="20,10,20,0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="10">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="14,8"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="Result" FontSize="10" FontWeight="600"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center"/>
              <Border Grid.Column="2" CornerRadius="4" Padding="8,2"
                      Background="{DynamicResource SurfaceElevatedBrush}">
                <TextBlock Text="{Binding OperationLabel}" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
              </Border>
            </Grid>
          </Border>

          <!-- Error card -->
          <Border Grid.Row="0" IsVisible="{Binding IsError}"
                  Margin="14,10" CornerRadius="8" Padding="14,10"
                  Background="#1AFF4444" BorderBrush="{DynamicResource AccentRedBrush}"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="&#x26A0;" FontSize="14"
                         Foreground="{DynamicResource AccentRedBrush}"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ErrorText}" FontSize="12"
                         Foreground="{DynamicResource AccentRedBrush}"
                         TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Result content -->
          <Border Grid.Row="1" Margin="14,10"
                  IsVisible="{Binding !IsError}">
            <StackPanel>
              <TextBlock Text="{Binding ResultDisplay}"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="18" FontWeight="300"
                         Foreground="{DynamicResource AccentBlueBrush}"
                         TextWrapping="Wrap"/>

              <!-- Working indicator -->
              <Border IsVisible="{Binding IsWorking}" Margin="0,8,0,0"
                      CornerRadius="4" Padding="8,4"
                      Background="{DynamicResource SurfaceElevatedBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Background="{DynamicResource AccentPurpleBrush}"
                          CornerRadius="8" Width="8" Height="8"/>
                  <TextBlock Text="Computing..." FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Empty state -->
          <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                      IsVisible="{Binding !IsError}">
            <TextBlock Text="&#x0192;" FontSize="36" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentBlueBrush}" Opacity="0.2"/>
            <TextBlock Text="Enter an expression and press Enter" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="3" Margin="20,8,20,12"
              CornerRadius="6" Padding="10,5"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center">
            <Border CornerRadius="4" Width="6" Height="6"
                    Background="{DynamicResource AccentTealBrush}"/>
            <TextBlock Text="{Binding OperationLabel}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding VariableListText}"
                     FontSize="10" Margin="12,0,0,0"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2"
                     Text="{Binding History.Count, StringFormat='{}{0} items'}"
                     FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ═══ RIGHT: History Panel ═══ -->
    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
            CornerRadius="0">
      <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="History" FontSize="11" FontWeight="600"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearHistoryCommand}"
                    FontSize="10" Padding="6,2" CornerRadius="4"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource TextTertiaryBrush}"
                    MinHeight="20"/>
          </Grid>
        </Border>

        <!-- Search -->
        <Border DockPanel.Dock="Top" Padding="10,6">
          <TextBox Watermark="Search history..." Text="{Binding FilterText}"
                   FontSize="11" CornerRadius="4" MinHeight="24" Padding="6,3"
                   Background="{DynamicResource CanvasBrush}"/>
        </Border>

        <!-- History list -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HistoryItem}">
                <Border CornerRadius="6" Padding="10,7" Margin="4,2"
                        Background="{DynamicResource CanvasBrush}"
                        Cursor="Hand">
                  <DockPanel>
                    <Border DockPanel.Dock="Bottom" Margin="0,5,0,0"
                            CornerRadius="3" Padding="6,2"
                            Background="{DynamicResource SurfaceElevatedBrush}">
                      <TextBlock Text="{Binding Result}" FontSize="11"
                                 Foreground="{DynamicResource AccentBlueBrush}"
                                 FontWeight="500" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Expression}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                      <Border Grid.Column="1" CornerRadius="3" Padding="4,1"
                              Background="{DynamicResource SurfaceElevatedBrush}"
                              Margin="4,0,0,0">
                        <TextBlock Text="{Binding Operation}" FontSize="9"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                      </Border>
                    </Grid>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
