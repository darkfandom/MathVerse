<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathVerse.Desktop.Views.EvaluateView">

  <Border Background="{DynamicResource SurfaceBrush}" Margin="0" CornerRadius="0">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="&#x0192;" FontSize="48" HorizontalAlignment="Center"
                 Foreground="{DynamicResource AccentBlueBrush}" Opacity="0.3"/>
      <TextBlock Text="Evaluate" FontSize="20" FontWeight="300" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
      <TextBlock Text="Type an expression to evaluate" FontSize="13" HorizontalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
  </Border>

</UserControl>
