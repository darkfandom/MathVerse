<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathVerse.Desktop.InspectorPanel">
  <Border Background="#13131E">
    <Grid RowDefinitions="28,*">
      <Border Grid.Row="0" Background="#1A1A26" BorderBrush="#222" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" Margin="8,0">
          <TextBlock Grid.Column="0" Text="INSPECTOR" Foreground="#888" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="&#x25BE;" Foreground="#555" FontSize="10" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- No Selection State -->
      <TextBlock x:Name="NoSelectionText" Grid.Row="1"
                 Text="No selection" Foreground="#444" FontSize="13"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="True" />

      <!-- Selection Properties -->
      <ScrollViewer x:Name="PropertyPanel" Grid.Row="1" IsVisible="False"
                    Background="#13131E" Padding="0,4">
        <StackPanel Spacing="2">
          <Border Background="#1A1A26" Padding="8,6">
            <TextBlock x:Name="ObjectName" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" />
          </Border>
          <Border Background="#1A1A26" Padding="8,4">
            <Grid ColumnDefinitions="80,*">
              <TextBlock Text="Type" Foreground="#666" FontSize="11" />
              <TextBlock x:Name="ObjectType" Grid.Column="1" Foreground="#AAA" FontSize="11" />
            </Grid>
          </Border>
          <Border Background="#1A1A26" Padding="8,4">
            <Grid ColumnDefinitions="80,*">
              <TextBlock Text="Id" Foreground="#666" FontSize="11" />
              <TextBlock x:Name="ObjectId" Grid.Column="1" Foreground="#AAA" FontSize="11" />
            </Grid>
          </Border>
          <Border Background="#1A1A26" Padding="8,4">
            <Grid ColumnDefinitions="80,*">
              <TextBlock Text="Visible" Foreground="#666" FontSize="11" />
              <TextBlock x:Name="ObjectVisible" Grid.Column="1" Foreground="#AAA" FontSize="11" />
            </Grid>
          </Border>
          <Border Background="#1A1A26" Padding="8,4">
            <Grid ColumnDefinitions="80,*">
              <TextBlock Text="Expression" Foreground="#666" FontSize="11" />
              <TextBlock x:Name="ObjectExpression" Grid.Column="1" Foreground="#AAA" FontSize="11" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
