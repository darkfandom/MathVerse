<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MathVerse.Desktop.ViewportPanel"
             Focusable="True"
             Background="#0B0B12">
  <Grid>
    <!-- Render surface -->
    <Image x:Name="RenderImage" Stretch="Fill" />

    <!-- Selection overlay -->
    <Border x:Name="SelectionRect" IsVisible="False"
            Background="#2D5F8A" Opacity="0.2"
            BorderBrush="#4A9EFF" BorderThickness="1"
            CornerRadius="1"
            HorizontalAlignment="Left" VerticalAlignment="Top" />

    <!-- Coordinate display (bottom-left) -->
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Background="#1A1A26" Opacity="0.7"
            CornerRadius="3" Padding="6,2" Margin="4,0,0,4">
      <TextBlock x:Name="CoordDisplay" Text="(0.00, 0.00)" Foreground="#888" FontSize="11" />
    </Border>

    <!-- Zoom level display (bottom-right) -->
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
            Background="#1A1A26" Opacity="0.7"
            CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
      <TextBlock x:Name="ZoomDisplay" Text="100%" Foreground="#888" FontSize="11" />
    </Border>

    <!-- FPS/status (top-right) -->
    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
            Background="#1A1A26" Opacity="0.5"
            CornerRadius="3" Padding="6,2" Margin="0,4,4,0">
      <TextBlock x:Name="StatusDisplay" Text="" Foreground="#555" FontSize="10" />
    </Border>
  </Grid>
</UserControl>
