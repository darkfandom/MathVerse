<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathVerse.Desktop.ViewModels"
             x:Class="MathVerse.Desktop.Views.GraphView"
             x:DataType="vm:GraphViewModel"
             Background="{DynamicResource CanvasBrush}">

  <Grid ColumnDefinitions="320,*,280" RowDefinitions="*">

    <!-- ═══ LEFT: Expression List ═══ -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="14,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="Graph Studio" FontSize="14" FontWeight="600"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Functions &amp; Expressions" FontSize="11"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
          </StackPanel>
        </Border>

        <!-- Add Function Bar -->
        <Border DockPanel.Dock="Top" Padding="10,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Watermark="e.g. sin(x), x^2"
                       Text="{Binding NewExpression}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="12" CornerRadius="6" MinHeight="30" Padding="8,4"
                       KeyDown="ExpressionInput_KeyDown"/>
              <Button Grid.Column="1" Content="+" Command="{Binding AddGraphCommand}"
                      Margin="6,0,0,0" Width="30" CornerRadius="6"
                      Background="{DynamicResource AccentBlueBrush}"
                      Foreground="#FFFFFF" FontSize="14" FontWeight="700"
                      MinHeight="30" Padding="0"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <ComboBox Grid.Column="0" ItemsSource="{Binding GraphTypes}"
                        SelectedIndex="{Binding SelectedGraphTypeIndex}"
                        FontSize="11" MinHeight="24" Padding="6,2"
                        HorizontalAlignment="Stretch"/>
              <Button Grid.Column="1" Content="Clear" Command="{Binding ClearGraphsCommand}"
                      Margin="6,0,0,0" FontSize="10" Padding="8,2" CornerRadius="4"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource TextTertiaryBrush}" MinHeight="24"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Expression List -->
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Graphs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:GraphEntry}">
                <Border CornerRadius="8" Padding="10,8" Margin="6,3"
                        Background="{DynamicResource CanvasBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Cursor="Hand">
                  <DockPanel>
                    <!-- Top row: icon + expression + delete -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="&#x25CF;" FontSize="10"
                                 Foreground="{Binding Color}"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding Expression}"
                                 FontSize="12" FontWeight="500"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"/>
                      <Border Grid.Column="2" CornerRadius="3" Padding="4,1"
                              Background="{DynamicResource SurfaceElevatedBrush}"
                              Margin="4,0">
                        <TextBlock Text="{Binding Type}" FontSize="9"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                      </Border>
                      <TextBlock Grid.Column="3" Text="&#x2715;" FontSize="10"
                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                 Cursor="Hand" Margin="6,0,0,0"
                                 Tag="{Binding}"
                                 DoubleTapped="DeleteGraph_DoubleTapped"/>
                    </Grid>
                    <!-- Visibility + slider count -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto"
                          Margin="0,4,0,0">
                      <TextBlock Grid.Column="0" Text="{Binding IsVisible, StringFormat='{}{0}'}"
                                 FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}"
                                 VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="9"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding ParameterSliders.Count, StringFormat='{}{0} params'}"/>
                      </StackPanel>
                    </Grid>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Presets -->
        <Border DockPanel.Dock="Bottom" Padding="10,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <StackPanel>
            <TextBlock Text="Quick Presets" FontSize="10" FontWeight="600"
                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,6"/>
            <WrapPanel>
              <Button Content="sin(x)" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="sin(x)" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="x^2" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="x^2" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="cos(x)" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="cos(x)" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="tan(x)" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="tan(x)" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="1/x" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="1/x" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="e^x" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="exp(x)" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="ln(x)" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="ln(x)" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="sqrt(x)" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="sqrt(x)" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="|x|" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="abs(x)" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
              <Button Content="sin(x)/x" Command="{Binding AddPresetExampleCommand}"
                      CommandParameter="sin(x)/x" Margin="0,0,4,4"
                      FontSize="10" Padding="8,3" CornerRadius="4"
                      Background="{DynamicResource SurfaceElevatedBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ═══ CENTER: Viewport + Toolbar + Timeline ═══ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

      <!-- Toolbar -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
              Padding="8,4">
        <WrapPanel>
          <Button Content="Home" Command="{Binding HomeCommand}" FontSize="11"
                  Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Button Content="Fit All" Command="{Binding FitAllCommand}" FontSize="11"
                  Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                  Margin="4,0" VerticalAlignment="Center"/>
          <Button Content="+" Command="{Binding ZoomInCommand}" FontSize="11"
                  Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Button Content="-" Command="{Binding ZoomOutCommand}" FontSize="11"
                  Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                  Margin="4,0" VerticalAlignment="Center"/>
          <Button Content="Grid" Command="{Binding ToggleGridCommand}" FontSize="11"
                  Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Button Content="Reset" Command="{Binding ResetViewCommand}" FontSize="11"
                  Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Button Content="Export" Command="{Binding ExportPngCommand}" FontSize="11"
                  Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource AccentTealBrush}"
                  Foreground="#FFFFFF"/>
          <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                  Margin="4,0" VerticalAlignment="Center"/>
          <Button Content="3D" FontSize="11" Padding="8,4" CornerRadius="4" Margin="2,0"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
        </WrapPanel>
      </Border>

      <!-- Viewport Canvas -->
      <Border Grid.Row="1" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
        <Panel>
          <Image x:Name="ViewportImage"
                 Source="{Binding ViewportBitmap}"
                 Stretch="Uniform"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 PointerWheelChanged="ViewportImage_PointerWheelChanged"
                 PointerPressed="ViewportImage_PointerPressed"
                 PointerReleased="ViewportImage_PointerReleased"
                 PointerMoved="ViewportImage_PointerMoved"
                 DoubleTapped="ViewportImage_DoubleTapped"/>
          <!-- Crosshair + Coordinates -->
          <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,8,12,0" CornerRadius="4" Padding="6,3"
                  Background="{DynamicResource SurfaceBrush}" Opacity="0.85">
            <TextBlock Text="{Binding HoverCoords}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="Cascadia Code, Consolas, monospace"/>
          </Border>
          <!-- Empty state -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      IsVisible="{Binding !Graphs.Count}">
            <TextBlock Text="&#x221F;" FontSize="48" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentPurpleBrush}" Opacity="0.15"/>
            <TextBlock Text="Add a function to begin" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="Type an expression in the left panel" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" Opacity="0.5"/>
          </StackPanel>
        </Panel>
      </Border>

      <!-- Timeline -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
              Padding="12,6">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                      VerticalAlignment="Center">
            <Button Content="&#x25B6;" Command="{Binding ToggleAnimationCommand}"
                    FontSize="10" Padding="6,2" CornerRadius="4"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" MinHeight="22"/>
            <Button Content="&#x23F9;" Command="{Binding StopAnimationCommand}"
                    FontSize="10" Padding="6,2" CornerRadius="4"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}" MinHeight="22"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CurrentTime, StringFormat='{}{0:F2}s'}"
                     FontSize="11" Margin="8,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="Cascadia Code, Consolas, monospace"/>
          <Slider Grid.Column="2" Minimum="0" Maximum="{Binding AnimationDuration}"
                  Value="{Binding CurrentTime}"
                  Width="200" VerticalAlignment="Center" Margin="8,0"/>
          <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="11"
                     Margin="8,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextTertiaryBrush}"/>
          <TextBlock Grid.Column="4" Text="{Binding Fps, StringFormat='{}{0} FPS'}"
                     FontSize="10" Margin="8,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     FontFamily="Cascadia Code, Consolas, monospace"/>
          <TextBlock Grid.Column="5" Text="{Binding HoverCoords}" FontSize="10"
                     Margin="8,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     FontFamily="Cascadia Code, Consolas, monospace"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ═══ RIGHT: Properties Panel ═══ -->
    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="Properties" FontSize="12" FontWeight="600"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>

        <ScrollViewer>
          <StackPanel Margin="12,8">
            <!-- No Selection -->
            <TextBlock Text="Select a graph to edit properties"
                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                       IsVisible="{Binding !SelectedGraph}"
                       Margin="0,20,0,0" TextWrapping="Wrap"/>

            <!-- Selected Graph Properties -->
            <StackPanel IsVisible="{Binding SelectedGraph}" Spacing="8">
              <!-- Expression -->
              <TextBlock Text="Expression" FontSize="10" FontWeight="600"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
              <TextBox Text="{Binding SelectedGraph.Expression}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="12" CornerRadius="4" Padding="6,4" MinHeight="28"
                       Watermark="Mathematical expression"/>

              <!-- Color -->
              <TextBlock Text="Color" FontSize="10" FontWeight="600" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
              <WrapPanel>
                <Button Background="#4A9EFF" Width="22" Height="22" CornerRadius="11"
                        Margin="2" Command="{Binding $parent[UserControl].((vm:GraphViewModel)DataContext).SetGraphColorCommand}"
                        CommandParameter="#4A9EFF"/>
                <Button Background="#8B5CF6" Width="22" Height="22" CornerRadius="11"
                        Margin="2"/>
                <Button Background="#06D6A0" Width="22" Height="22" CornerRadius="11"
                        Margin="2"/>
                <Button Background="#FF6B35" Width="22" Height="22" CornerRadius="11"
                        Margin="2"/>
                <Button Background="#FF4444" Width="22" Height="22" CornerRadius="11"
                        Margin="2"/>
                <Button Background="#FFD700" Width="22" Height="22" CornerRadius="11"
                        Margin="2"/>
                <Button Background="#E879F9" Width="22" Height="22" CornerRadius="11"
                        Margin="2"/>
                <Button Background="#22D3EE" Width="22" Height="22" CornerRadius="11"
                        Margin="2"/>
              </WrapPanel>

              <!-- Line Width -->
              <TextBlock Text="Line Width" FontSize="10" FontWeight="600" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
              <Slider Minimum="0.5" Maximum="5"
                      Value="{Binding SelectedGraph.LineWidth}"/>

              <!-- Domain -->
              <TextBlock Text="Domain" FontSize="10" FontWeight="600" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
              <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0" Text="X:" FontSize="10" Margin="0,0,4,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SelectedGraph.XMin}" FontSize="11"
                         CornerRadius="3" Padding="4,2" MinHeight="22"/>
                <TextBlock Grid.Column="2" Text="-" FontSize="10" Margin="4,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Text="{Binding SelectedGraph.XMax}" FontSize="11"
                         CornerRadius="3" Padding="4,2" MinHeight="22"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Y:" FontSize="10" Margin="0,0,4,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding SelectedGraph.YMin}" FontSize="11"
                         CornerRadius="3" Padding="4,2" MinHeight="22"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Text="-" FontSize="10" Margin="4,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Grid.Row="1" Text="{Binding SelectedGraph.YMax}" FontSize="11"
                         CornerRadius="3" Padding="4,2" MinHeight="22"/>
              </Grid>

              <!-- Options -->
              <TextBlock Text="Options" FontSize="10" FontWeight="600" Margin="0,4,0,0"
                         Foreground="{DynamicResource TextTertiaryBrush}"/>
              <CheckBox Content="Show Grid" IsChecked="{Binding SelectedGraph.ShowGrid}"
                        FontSize="11"/>
              <CheckBox Content="Show Axes" IsChecked="{Binding SelectedGraph.ShowAxes}"
                        FontSize="11"/>
              <CheckBox Content="Fill Under Curve" IsChecked="{Binding SelectedGraph.ShowFill}"
                        FontSize="11"/>

              <!-- Parameter Sliders -->
              <ItemsControl ItemsSource="{Binding SelectedGraph.ParameterSliders}"
                            Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ParameterSlider}">
                    <StackPanel Margin="0,4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                   FontSize="11" FontWeight="500"
                                   Foreground="{DynamicResource AccentTealBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:F2}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   VerticalAlignment="Center"/>
                      </Grid>
                      <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                              Value="{Binding Value}"
                              Margin="0,2,0,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
