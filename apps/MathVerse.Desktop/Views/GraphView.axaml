<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathVerse.Desktop.ViewModels"
             x:Class="MathVerse.Desktop.Views.GraphView"
             x:DataType="vm:GraphViewModel"
             Background="{DynamicResource CanvasBrush}">

  <Border Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
    <Panel>
      <Image x:Name="ViewportImage"
             Source="{Binding ViewportBitmap}"
             Stretch="Uniform"
             RenderOptions.BitmapInterpolationMode="HighQuality"
             PointerWheelChanged="ViewportImage_PointerWheelChanged"
             PointerPressed="ViewportImage_PointerPressed"
             PointerReleased="ViewportImage_PointerReleased"
             PointerMoved="ViewportImage_PointerMoved"
             DoubleTapped="ViewportImage_DoubleTapped"/>
      <!-- Coordinates -->
      <Border HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,8,12,0" CornerRadius="4" Padding="6,3"
              Background="{DynamicResource SurfaceBrush}" Opacity="0.85">
        <TextBlock Text="{Binding HoverCoords}" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontFamily="Cascadia Code, Consolas, monospace"/>
      </Border>
      <!-- Status -->
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="12,0,0,8" CornerRadius="4" Padding="6,3"
              Background="{DynamicResource SurfaceBrush}" Opacity="0.85">
        <TextBlock FontSize="10"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   FontFamily="Cascadia Code, Consolas, monospace">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}Zoom: {0:F1} | {1}">
              <Binding Path="ViewportScale"/>
              <Binding Path="StatusText"/>
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </Border>
      <!-- Empty state -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsVisible="{Binding !Graphs.Count}">
        <TextBlock Text="&#x221F;" FontSize="64" HorizontalAlignment="Center"
                   Foreground="{DynamicResource AccentPurpleBrush}" Opacity="0.08"/>
        <TextBlock Text="Add a function to begin" FontSize="16"
                   HorizontalAlignment="Center" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>
        <TextBlock Text="Type an expression above or click Quick Add" FontSize="12"
                   HorizontalAlignment="Center" Margin="0,4,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}" Opacity="0.5"/>
        <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
          <Button Content="sin(x)" Command="{Binding AddPresetExampleCommand}"
                  CommandParameter="sin(x)" Margin="0,0,4,4"
                  FontSize="11" Padding="10,4" CornerRadius="4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Button Content="x^2" Command="{Binding AddPresetExampleCommand}"
                  CommandParameter="x^2" Margin="0,0,4,4"
                  FontSize="11" Padding="10,4" CornerRadius="4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Button Content="cos(x)" Command="{Binding AddPresetExampleCommand}"
                  CommandParameter="cos(x)" Margin="0,0,4,4"
                  FontSize="11" Padding="10,4" CornerRadius="4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
          <Button Content="e^x" Command="{Binding AddPresetExampleCommand}"
                  CommandParameter="exp(x)" Margin="0,0,4,4"
                  FontSize="11" Padding="10,4" CornerRadius="4"
                  Background="{DynamicResource SurfaceElevatedBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>
        </WrapPanel>
      </StackPanel>
    </Panel>
  </Border>

</UserControl>
