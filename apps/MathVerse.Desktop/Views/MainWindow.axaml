<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MathVerse.Desktop.Views"
        xmlns:vm="using:MathVerse.Desktop.ViewModels"
        x:Class="MathVerse.Desktop.Views.MainWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="MathVerse"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="768"
        Background="{DynamicResource CanvasBrush}"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Top Toolbar -->
    <Border DockPanel.Dock="Top" Height="44"
            Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="16,0">
      <DockPanel>
        <TextBlock Text="{Binding CurrentTitle}" FontSize="13" FontWeight="500"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="10,5" MinWidth="200">
            <TextBlock Text="Search... (Ctrl+K)" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bottom Status Bar -->
    <Border DockPanel.Dock="Bottom" Height="24"
            Background="{DynamicResource CanvasBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="12,0">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentTealBrush}" CornerRadius="4"
                  Width="8" Height="8"/>
          <TextBlock Text="Ready" FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="v0.6.0" FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"/>
          <TextBlock Text="Backend: Online" FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="MathVerse" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Main Content: Sidebar + Viewport -->
    <Grid ColumnDefinitions="200,*">
      <views:Sidebar Grid.Column="0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <views:ViewportHost Grid.Column="1" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>

  </DockPanel>

</Window>
